<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reja</title>
    <link rel="stylesheet" href="/reja.css" />
  </head>
  <body style="background-color: #b8bbd1">
    <div class="container">
      <h1 class="display-4 text-center py-1">REJA VA MAQSADLAR</h1>

      <div class="jumbotron p-3 shadow-sm">
        <form id="create-form" action="/create-item" method="POST">
          <div class="d-flex align-items-center">
            <input
              id="create-field"
              name="item"
              autofocus
              autocomplete="off"
              class="form-control mr-3"
              type="text"
              style="flex: 1"
            />
            <button class="btn btn-primary" style="border-radius: 20px">
              Yangi Reja Qushish
            </button>
          </div>
        </form>
      </div>

      <ul id="items-list" class="list-group mb-3"></ul>

      <div>
        <button
          id="clean_all"
          class="btn btn-danger"
          style="border-radius: 20px; display: none"
        >
          Hamma Rejalarni O'chirish
        </button>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("create-form");
        const input = document.getElementById("create-field");
        const itemsList = document.getElementById("items-list");
        const cleanAllBtn = document.getElementById("clean_all");

        form.addEventListener("submit", function (e) {
          e.preventDefault();

          const itemText = input.value.trim();
          if (!itemText) return;

          fetch("/create-item", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ item: itemText }),
          })
            .then((res) => res.json())
            .then((data) => {
              addItemToList(data.item || itemText);
              input.value = "";
              input.focus();
            })
            .catch((err) => console.log("ERROR:", err));
        });

        function addItemToList(text) {
          const li = document.createElement("li");
          li.className = "list-group-item";
          li.textContent = text;
          itemsList.appendChild(li);
          cleanAllBtn.style.display = "inline-block";
        }

        cleanAllBtn.addEventListener("click", function () {
          itemsList.innerHTML = "";
          cleanAllBtn.style.display = "none";
        });
      });
    </script>
  </body>
</html>